# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local logs only
/logs/

# Unpacked EPUB trees (directories named *.epub) — keep only archive files
/books/100M Money Models.epub/
/books/Mathematical Thinking - for People Who Hate Math Level Up Your Analytical and Creative Thinking Skills Excel at Problem-Solving and Decision-Making.epub/

# Composio download scratch (not part of the library)
/books/from-drive/jobs.jsonl
/books/from-drive/manifest.json
/books/from-drive/missing_urls.json
